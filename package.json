{
  "name": "primary-entry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server/main.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "build:apps": "node scripts/build-apps.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "build": "npm run build:apps && npm run build:web",
    "typecheck": "tsc -p . && tsc -p src/web --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "^5.1.0",
    "preact": "^10.29.8",
    "serverless-http": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "aws-sdk-client-mock": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  }
}
