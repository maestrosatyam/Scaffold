# Scaffold configuration. Every variable is optional for a local demo, so `npm start` works with none of them set.

# HTTP
HOST=127.0.0.1
PORT=8787
# On a public host, list the hostnames and origins that are allowed (DNS-rebinding / Origin protection).
# ALLOWED_HOSTS=scaffold.example.com
# ALLOWED_ORIGINS=scaffold.example.com

# Storage: sqlite (default, data/scaffold.db) | memory | dynamodb
SCAFFOLD_STORE=sqlite
# SCAFFOLD_DB=./data/scaffold.db
# SCAFFOLD_TABLE=scaffold-events        # when SCAFFOLD_STORE=dynamodb
# DYNAMODB_ENDPOINT=http://localhost:8000

# Time zone used for spoken times and the demo history
SCAFFOLD_TZ=America/Los_Angeles

# Auth
# Static tokens, comma-separated, in the form token=personId:role:actorId.
# When unset, local demo tokens are used: demo-learner and demo-coach (for person "sam").
# SCAFFOLD_TOKENS=change-me-learner=sam:learner:sam,change-me-coach=sam:coach:priya
# Anonymous callers (no Authorization header) act as the demo learner locally.
# Set this to "none" on any public deployment.
SCAFFOLD_ANONYMOUS=learner
# HMAC secret for demo-sandbox tokens. Locally it is generated and kept in data/.token-secret.
# SCAFFOLD_TOKEN_SECRET=<at least 32 random hex chars>

# Demo
SCAFFOLD_DEMO=1
# The demo clock starts each sandbox at this local time. Set to "real" to use wall-clock time.
SCAFFOLD_DEMO_START=07:24
